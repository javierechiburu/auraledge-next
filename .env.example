# === Strapi (backend/CMS) ===
# URL pública de tu instancia de Strapi (sin slash final)
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
# API Token de Strapi (Settings > API Tokens, tipo Full access).
# REQUERIDO para crear/actualizar órdenes y leer el archivo full privado.
STRAPI_API_TOKEN=

# === Cloudflare R2 (bucket privado) — SOLO servidor ===
# Mismas credenciales que el .env de Strapi. Se usan para firmar URLs temporales:
# imagen/preview (larga duración) y fullTrack (5 min, solo tras compra verificada).
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=<nombre-de-tu-bucket>
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Host del endpoint R2 para autorizar next/image (sin https://).
NEXT_PUBLIC_MEDIA_HOSTNAME=<account-id>.r2.cloudflarestorage.com

# === Sitio ===
# URL pública de este sitio (para back_urls, webhook y links de descarga)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === Mercado Pago ===
# Access Token (Credenciales de producción o de prueba). Requerido para /api/checkout.
MP_ACCESS_TOKEN=
# Secreto de firma del webhook (panel de MP > Webhooks). Requerido en producción
# para validar la firma de las notificaciones antes de entregar la descarga.
MP_WEBHOOK_SECRET=
# Public Key (opcional, solo si se usan Bricks/Checkout API en el cliente)
NEXT_PUBLIC_MP_PUBLIC_KEY=

# === Entrega digital ===
# Secreto para firmar los links de descarga (cadena larga y aleatoria, >=32 chars)
DOWNLOAD_TOKEN_SECRET=
# Resend (correo de descarga). API key desde https://resend.com
RESEND_API_KEY=
# Remitente verificado en Resend. En pruebas puedes usar onboarding@resend.dev
RESEND_FROM_EMAIL=Genio Music <onboarding@resend.dev>

# === Panel de administración ===
# Correos con acceso al dashboard de ventas (/ventas), separados por coma.
ADMIN_EMAILS=

# === Autenticación ===
# Login con Google (Strapi Providers). Ponlo en "true" cuando hayas configurado
# las credenciales de Google en Strapi; habilita el botón de Google en la UI.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
