# URL pública de tu instancia de Strapi (sin slash final)
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# API Token de Strapi (Settings > API Tokens). Opcional si tus endpoints son públicos.
STRAPI_API_TOKEN=

# URL pública de este sitio (usada para construir las back_urls y el webhook de Mercado Pago)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Access Token de Mercado Pago (Credenciales de producción o de prueba)
MP_ACCESS_TOKEN=

# Public Key de Mercado Pago (opcional, solo si más adelante se usan Bricks/Checkout API en el cliente)
NEXT_PUBLIC_MP_PUBLIC_KEY=
